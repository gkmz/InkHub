# 文章根目录（相对于工具目录，或使用绝对路径）
POSTS_DIR=your_posts_dir

# 发布图片到 GitHub（可选；只预览本地文章时不需要）
GITHUB_TOKEN=your_token_here
GITHUB_REPO=your_username/your_repo
GITHUB_BRANCH=main
GITHUB_PATH_PREFIX=posts

# 注意：
# 1. Public 仓库建议使用 fine-grained token，并只授予 Contents 读写权限
# 2. 目前仅支持 GitHub 图床

POSTS_BASE_URL=your_blog_domain
