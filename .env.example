# InkHub 数据目录；必须使用绝对路径，留空时使用操作系统应用数据目录
# macOS 示例：/Users/your-name/Library/Application Support/InkHub
INKHUB_DATA_DIR=

# InkHub 日志级别：debug、info、warn、error
INKHUB_LOG_LEVEL=info

# 日志文件路径；留空时使用 <data-dir>/logs/inkhub.log
INKHUB_LOG_FILE=

# 单个日志文件最大容量，单位 MiB
INKHUB_LOG_MAX_SIZE=100

# 是否同时将易读日志输出到控制台
INKHUB_LOG_CONSOLE=true
